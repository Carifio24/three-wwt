{
  "compilerOptions": {
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true
  },
  "paths": {
    "@wwtelescope/engine": [
      "src/wwt-shims.d.ts"
    ],
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules"]
}
